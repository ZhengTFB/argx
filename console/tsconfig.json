{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  // device/ 是阶段一的虚拟设备、sdk/ 是阶段三的网页 SDK，
  // 两边都是直接复用那一份文件（不复制、不重写），
  // 所以必须让 TS 把它们纳入编译范围，否则副作用导入会报"找不到模块"。
  "include": ["src", "vite.config.ts", "../device", "../sdk"]
}
